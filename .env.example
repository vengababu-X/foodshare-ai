# MongoDB — the URI must end with a dedicated database name (never a sample
# database like sample_mflix). If no database is present, foodshare_db is used.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/foodshare_db
# Optional: override the dedicated database name (default: foodshare_db)
MONGODB_DB=foodshare_db

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Google Maps API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Upstash Redis (for real-time features and caching)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Cloudinary (server-side SDK uploads)
CLOUDINARY_URL=cloudinary://api_key:api_secret@your-cloud-name
# Cloudinary (browser-side unsigned uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# Pusher (cross-device real-time sync)
PUSHER_APP_ID=your-pusher-app-id
NEXT_PUBLIC_PUSHER_KEY=your-pusher-key
PUSHER_SECRET=your-pusher-secret
NEXT_PUBLIC_PUSHER_CLUSTER=mt1

# File uploads
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=5242880 # 5MB

# App settings
NODE_ENV=development
PORT=3000

# Email (for notifications - optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# SMS (for notifications - optional)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890